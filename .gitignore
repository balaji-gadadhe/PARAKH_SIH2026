# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/

# Environments
# NOTE (D-027, hackathon mode): .env is COMMITTED — it contains placeholders only
# (no real secrets; nothing in the repo reads env vars yet). After the demo,
# re-ignore .env and restore the gitignored convention (D-016).
#.env
#.env.*
!.env.example
.venv/
venv/
ENV/
env/

# IDE & Editor artifacts
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Presentation exports and source files
*.pdf
*.ppt
*.pptx

# Raw source datasets
mplads_completed_works_*.csv
mplads_expenditures_*.csv
mplads_mp_summary_*.csv
mplads_recommended_works_*.csv

# Root-level generated master copies
/master_works.csv
/master_mp_summary.csv

# Demo data shipped in-repo (D-027): data/master + the unified risk output are
# committed so every clone runs the identical dataset — no regeneration drift.
!data/master/master_works.csv
!data/master/master_mp_summary.csv

# Realtime runtime-generated data
realtime/data/runtime/*
!realtime/data/runtime/.gitkeep

# Realtime generated event streams
realtime/data/events/*.jsonl

# Generated ML output artifacts
# (D-027 exception: the demo-critical outputs are committed — see allowlist below)
ml_features/ml_outputs/*
!ml_features/ml_outputs/project_risk_results.csv.gz
!ml_features/ml_outputs/agency_profiles.csv
/ML_OUTPUT/
/ml_output/
/data/ml_output/
/data/ml_outputs/

# Local model artifacts
*.pkl
# *.joblib — the 4 trained model artifacts are tracked (needed for tests)
*.onnx

# Reports demo (D-029): runtime SQLite inbox store — never commit runtime state
backend/reports.db

# Browser walkthrough screenshots (generated by scripts/walkthrough_reports_flow.py)
scripts/walkthrough_shots/

# Checklist sweep screenshots (generated by scripts/checklist_full.py)
scripts/checklist_shots/

# Local logs
*.log


# D-032 citizen portal runtime state
citizen.db
backend/citizen.db
backend/uploads/
