# PARAKH (SIH-2026) — environment template
# -----------------------------------------------------------------------------
# 1. Copy this file to .env:     cp .env.example .env
#    (Windows:  copy .env.example .env)
# 2. `.env` is COMMITTED for the hackathon (D-027) with placeholder values only.
#    Nothing in the repo reads env vars yet. After the demo, re-ignore `.env`
#    and restore the gitignored convention (D-016). Never commit real secrets.
# -----------------------------------------------------------------------------

# Realtime replay API (uvicorn realtime.realtime_api:app)
REALTIME_REPLAY_SPEED=1.0
LOG_LEVEL=info

# Phase C backend (planned — FastAPI service over project_risk_results.csv)
SECRET_KEY=change-me
DATABASE_URL=sqlite:///./parakh.db